# Keep active sources and collaboration files consistent across host systems.
*.v text eol=lf
*.sv text eol=lf
*.vh text eol=lf
*.S text eol=lf
*.hex text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
