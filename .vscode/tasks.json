{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HDL: Lint",
      "type": "shell",
      "command": "make lint",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "HDL: Build",
      "type": "shell",
      "command": "make build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "HDL: Test",
      "type": "shell",
      "command": "make test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "HDL: Run core test",
      "type": "shell",
      "command": "make test-core TEST=core_basic",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "HDL: Wave",
      "type": "shell",
      "command": "make wave TEST=core_basic",
      "problemMatcher": []
    },
    {
      "label": "HDL: Open waveform",
      "type": "shell",
      "command": "make open-wave TEST=core_basic",
      "dependsOrder": "sequence",
      "dependsOn": "HDL: Wave",
      "problemMatcher": []
    },
    {
      "label": "ChipInventor: Generate package",
      "type": "shell",
      "command": "make chipinventor-package",
      "problemMatcher": []
    },
    {
      "label": "ChipInventor: Check package",
      "type": "shell",
      "command": "make chipinventor-check",
      "problemMatcher": []
    },
    {
      "label": "ChipInventor: Show status",
      "type": "shell",
      "command": "make chipinventor-status",
      "problemMatcher": []
    },
    {
      "label": "ChipInventor: Create validation record",
      "type": "shell",
      "command": "make chipinventor-validation-record DATE=${input:validationDate}",
      "problemMatcher": []
    },
    {
      "label": "OpenLane: Readiness",
      "type": "shell",
      "command": "make openlane-readiness",
      "problemMatcher": []
    },
    {
      "label": "HDL: Synthesize",
      "type": "shell",
      "command": "make synth",
      "problemMatcher": []
    },
    {
      "label": "HDL: Generate schematic",
      "type": "shell",
      "command": "make schematic MODULE=${input:schematicModule}",
      "problemMatcher": []
    },
    {
      "label": "HDL: Clean",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "validationDate",
      "type": "promptString",
      "description": "Manual ChipInventor validation date (YYYY-MM-DD)",
      "default": "YYYY-MM-DD"
    },
    {
      "id": "schematicModule",
      "type": "pickString",
      "description": "Official RTL module to render",
      "options": [
        "alu",
        "register_file",
        "memory",
        "immediate_gen",
        "control",
        "datapath",
        "riscv_top"
      ],
      "default": "alu"
    }
  ]
}
